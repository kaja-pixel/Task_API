          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();",
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Health check reports OK', function () {",
              "    pm.expect(response.status).to.eql('OK');",
              "});"
